# .env.example — placeholders only. Copy to .env and fill in real values;
# .env is gitignored and must never be committed.

# Where the standalone SQLite database lives (src/data/db.js). Defaults to
# ./frontier-run.db next to this file if unset.
FRONTIER_DB_PATH=./frontier-run.db

# Session/cookie signing secret for whatever front door a later phase
# builds (see src/auth/README.md). Generate a real random value per
# deployment — never reuse this placeholder, never hardcode a secret in
# source. e.g.: openssl rand -hex 32
SESSION_SECRET=replace-with-a-real-random-value

# ── Kolibri pool-source config (see src/pool/kolibri-source.md) ────────────
# Not wired to a real implementation yet in this repo — src/pool/build.js
# uses the fixtures in fixtures/ unless FRONTIER_USE_FIXTURE_POOL=0.
# Path to Kolibri's own SQLite database file on the machine this service
# runs on (only meaningful once a real loadSkillTreeCacheFromKolibri()
# implementation exists — see src/pool/kolibri-source.js).
KOLIBRI_DB_PATH=/home/USER/.kolibri/db.sqlite3

# The Kolibri content channel id to filter exercises to (e.g. the Khan
# Academy channel). Deliberately left blank here — never hardcode a real
# channel id in source; see the seam investigation's cleanliness flags for
# why this specific value was treated as config, not a literal, during
# extraction.
KOLIBRI_CHANNEL_ID=

# Set to 0 once a real Kolibri-backed loadCurriculumSource() exists and you
# want to use it instead of the bundled fixtures. Defaults to using fixtures
# (1) if unset.
FRONTIER_USE_FIXTURE_POOL=1

# ── Dev-only tripwire (src/engine/selection.js) ─────────────────────────────
# Set to 1 to enable assertServedLevelHonest()'s throw-on-mismatch check.
# Zero cost when unset/0 — leave unset for normal use.
FRONTIER_LEVEL_ASSERT=0
